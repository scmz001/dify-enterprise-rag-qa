# 复制为 .env 后按实际环境填写
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
DIFY_BASE_URL=http://localhost/v1

# 归档文件名里带的应用版本号，可留空
APP_VERSION=

# 回答模型：Dify 的 /chat-messages 响应里没有 model_name（实测顶层和 metadata 都没有），
# 这里手动标注兜底。响应若哪天真带了这个字段，以响应为准。
ANSWER_MODEL=qwen3-14b

# 关键词提取节点是 Dify 内部节点，API 响应里看不到，只能手动标注（仅作日志/归档参考）
KEYWORD_EXTRACT_MODEL=glm4:9b

# 成本估算单价（元/百万 token）；不设置时按 DeepSeek 定价 1 / 2，货币 CNY
COST_INPUT_PER_MILLION=1.0
COST_OUTPUT_PER_MILLION=2.0
COST_CURRENCY=CNY
